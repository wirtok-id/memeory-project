# =============================================================================
# MEMEORY — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# For production, use your CI/CD secrets manager (GitHub Secrets, etc.)
# =============================================================================

# =============================================================================
# APP CONFIGURATION
# =============================================================================

# Application name displayed in UI
APP_NAME=Memeory

# App environment: development | staging | production
APP_ENV=development

# App version (must match pubspec.yaml)
APP_VERSION=1.0.0

# Base URL for deep links (e.g., memeory.app)
APP_DEEP_LINK_SCHEME=memeory
APP_DEEP_LINK_HOST=app.memeory.app

# =============================================================================
# SUPABASE — Core Backend
# https://app.supabase.com → Settings → API
# =============================================================================

# Supabase Project URL (from Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon/Public Key (safe for client-side use)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (NEVER expose to client — backend/Edge Functions only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Project Reference ID (from Project Settings)
SUPABASE_PROJECT_REF=your-project-ref

# Supabase Database Direct Connection (for migrations/scripts)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Supabase Storage Bucket Names
SUPABASE_BUCKET_THUMBNAILS=meme-thumbnails
SUPABASE_BUCKET_MEDIA=meme-media
SUPABASE_BUCKET_AVATARS=avatars

# =============================================================================
# SUPABASE LOCAL DEVELOPMENT
# Run `supabase start` to get these values
# =============================================================================

SUPABASE_LOCAL_URL=http://localhost:54321
SUPABASE_LOCAL_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_LOCAL_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_LOCAL_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_LOCAL_STUDIO_URL=http://localhost:54323

# =============================================================================
# GROQ API — AI Features
# https://console.groq.com → API Keys
# =============================================================================

# Groq API Key (used in Edge Functions ONLY — never expose to client)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Models
GROQ_MODEL_FAST=llama3-8b-8192
GROQ_MODEL_BALANCED=llama3-70b-8192
GROQ_MODEL_POWERFUL=mixtral-8x7b-32768
GROQ_MODEL_GUARD=llama-guard-3-8b

# Groq Rate Limiting
GROQ_MAX_REQUESTS_PER_MINUTE=30
GROQ_MAX_TOKENS_PER_REQUEST=2048
GROQ_CACHE_TTL_SECONDS=2592000

# =============================================================================
# GOOGLE OAUTH — Authentication
# https://console.cloud.google.com → APIs & Services → Credentials
# =============================================================================

# Google OAuth Client ID (Web application)
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com

# Google OAuth Client ID (Android)
GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com

# Google OAuth Client ID (iOS)
GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com

# Google OAuth Client Secret (backend only)
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# =============================================================================
# REDDIT API — Trending Meme Collection
# https://www.reddit.com/prefs/apps → Create application
# =============================================================================

# Reddit App credentials (Script type)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=Memeory/1.0.0 by /u/your_reddit_username

# Reddit subreddits to monitor (comma-separated)
REDDIT_SUBREDDITS=memes,dankmemes,me_irl,AdviceAnimals,terriblefacebookmemes

# Reddit fetch limit per subreddit per run
REDDIT_FETCH_LIMIT=50

# =============================================================================
# YOUTUBE API — YouTube Shorts Trending
# https://console.cloud.google.com → YouTube Data API v3
# =============================================================================

# YouTube Data API v3 Key
YOUTUBE_API_KEY=AIzaSy-your-youtube-api-key

# YouTube search parameters
YOUTUBE_MEME_SEARCH_QUERY=meme funny trending
YOUTUBE_FETCH_LIMIT=25
YOUTUBE_REGION_CODE=ID

# =============================================================================
# TIKTOK DATA — Trending Collection
# Third-party aggregator or RapidAPI endpoint
# =============================================================================

# TikTok scraper/aggregator endpoint (third-party service)
TIKTOK_SCRAPER_ENDPOINT=https://your-tiktok-aggregator.com/api/trending
TIKTOK_SCRAPER_API_KEY=your_tiktok_scraper_key

# TikTok fetch configuration
TIKTOK_FETCH_LIMIT=30
TIKTOK_HASHTAGS=meme,memeindonesia,funny,viral

# =============================================================================
# SENTRY — Error Monitoring & Crash Reporting
# https://sentry.io → Settings → Projects → Client Keys
# =============================================================================

# Sentry DSN (safe for client-side use)
SENTRY_DSN=https://your-key@sentry.io/your-project-id

# Sentry environment label
SENTRY_ENVIRONMENT=development

# Sentry release version (auto-set in CI usually)
SENTRY_RELEASE=memeory@1.0.0

# Enable Sentry tracing (set to 0.0 in development to avoid noise)
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable AI features (set to false to disable all Groq calls)
FEATURE_AI_EXPLANATIONS=true
FEATURE_VIRAL_PREDICTION=true
FEATURE_SIMILARITY_SEARCH=true
FEATURE_TREND_REPORTS=true

# Enable analytics event tracking
FEATURE_ANALYTICS=true

# Enable content moderation agent
FEATURE_MODERATION=true

# Enable admin panel (restrict to admin users)
FEATURE_ADMIN_PANEL=true

# Enable community uploads (Phase 2)
FEATURE_COMMUNITY_UPLOADS=false

# Enable meme battle (Phase 2)
FEATURE_MEME_BATTLE=false

# =============================================================================
# LOCALIZATION
# =============================================================================

# Default language (en | id)
DEFAULT_LOCALE=id

# Supported locales (comma-separated)
SUPPORTED_LOCALES=en,id

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================

# How often the Trend Collector runs (cron expression)
AGENT_TREND_COLLECTOR_CRON=0 */6 * * *

# How often the Analytics Agent runs (cron expression)
AGENT_ANALYTICS_CRON=0 0 * * *

# How often Viral Prediction runs (cron expression)
AGENT_VIRAL_PREDICTION_CRON=0 12 * * *

# Maximum memes to analyze per agent run
AGENT_ANALYSIS_BATCH_SIZE=50

# Number of days to cache AI explanations
AGENT_EXPLANATION_CACHE_DAYS=30

# Minimum similarity threshold for similar memes (0.0–1.0)
AGENT_SIMILARITY_THRESHOLD=0.75

# =============================================================================
# RATE LIMITING
# =============================================================================

# API rate limits (per user per minute)
RATE_LIMIT_USER_PER_MINUTE=100

# API rate limits (per IP per minute, unauthenticated)
RATE_LIMIT_IP_PER_MINUTE=1000

# Rate limit for AI explanation requests (per user per day)
RATE_LIMIT_AI_EXPLANATIONS_PER_DAY=50

# =============================================================================
# CONTENT CONFIGURATION
# =============================================================================

# Number of memes per page (pagination)
MEMES_PER_PAGE=20

# Number of trending memes to show
TRENDING_MEMES_COUNT=20

# Number of timeline memes per year section
TIMELINE_MEMES_PER_SECTION=10

# Number of similar memes to show
SIMILAR_MEMES_COUNT=8

# Maximum search results
MAX_SEARCH_RESULTS=100

# Years to look back for timeline
TIMELINE_YEARS_BACK=3

# Minimum meme quality score to display (0–100)
MIN_QUALITY_SCORE=20

# =============================================================================
# STORAGE & CDN
# =============================================================================

# CDN base URL for meme thumbnails (optional — for custom CDN)
CDN_BASE_URL=https://cdn.memeory.app

# Maximum thumbnail size in bytes (2MB default)
MAX_THUMBNAIL_SIZE_BYTES=2097152

# Maximum meme media size in bytes (50MB default)
MAX_MEDIA_SIZE_BYTES=52428800

# Accepted image MIME types
ACCEPTED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================

# Admin user UUIDs (comma-separated Supabase user IDs)
ADMIN_USER_IDS=uuid1,uuid2

# Admin notification email
ADMIN_EMAIL=admin@memeory.app

# =============================================================================
# ANALYTICS (Optional)
# =============================================================================

# PostHog Analytics (privacy-friendly alternative to Firebase Analytics)
POSTHOG_API_KEY=phc_your_posthog_key
POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# DEVELOPMENT UTILITIES
# =============================================================================

# Enable verbose logging (development only)
DEBUG_VERBOSE=false

# Enable Flutter BLoC observer logging
DEBUG_BLOC=false

# Mock AI responses (avoids Groq API calls during development)
MOCK_AI_RESPONSES=false

# Seed random memes for testing
SEED_TEST_DATA=false

# Log all Supabase queries (development only)
DEBUG_SUPABASE_QUERIES=false
